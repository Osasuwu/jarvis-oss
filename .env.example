# Jarvis environment variables
# Copy this file to .env and fill in values.
# Do NOT commit .env — it's in .gitignore.

# ── Required: Claude API ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Optional: Supabase (comm_patterns / credential_registry / weekly-release) ─
# Memory itself is native/file-based (~/.claude/projects/<project>/memory/) and
# needs no Supabase env vars. These are only needed by scripts/comm_patterns/,
# scripts/analyze-comms/, and the credential_registry/weekly-release tables.
# Get from: Supabase project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here

# ── Optional: local Ollama (scripts/comm_patterns classifier, see
# scripts/lib/llm_client.py) — falls back to DeepSeek if unset/unreachable ───
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
DEEPSEEK_API_KEY=

# ── Optional: GitHub token (for MCP GitHub server) ───────────────────────────
GITHUB_TOKEN=

# ── Optional: Firecrawl (web research in /research and /nightly-research) ────
FIRECRAWL_API_KEY=

# ── Optional: Obsidian vault (for obsidian MCP server) ──────────────────────
OBSIDIAN_VAULT_PATH=

# ── Optional: Claude Code CLI override ───────────────────────────────────────
CLAUDE_CLI_PATH=claude

