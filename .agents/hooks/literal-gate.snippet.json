{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/literal-gate.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "^mcp__github__",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.agents/hooks/literal-gate.py\" || exit 2"
          }
        ]
      }
    ]
  }
}
