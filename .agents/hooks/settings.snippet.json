{
  "hooks": {
    "PreToolUse": [
        {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "py=python3; \"$py\" -c '' </dev/null 2>/dev/null || py=python; \"$py\" \"$CLAUDE_PROJECT_DIR/.agents/hooks/literal-gate.py\" || exit 2" }]
