{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.agents/hooks/secret-scanner.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.agents/hooks/protected-files.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.agents/hooks/secret-scanner.py\""
          }
        ]
      },
      {
        "matcher": "^mcp__github__(issue_write|add_issue_comment|update_issue_comment|create_pull_request|update_pull_request|pull_request_review_write|add_comment_to_pending_review|add_reply_to_pull_request_comment|create_or_update_file|push_files|create_gist|update_gist)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.agents/hooks/secret-scanner.py\""
          }
        ]
      }
    ]
  }
}
