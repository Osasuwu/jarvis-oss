{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.agents/hooks/secret-scanner.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.agents/hooks/protected-files.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.agents/hooks/secret-scanner.py\""
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_or_update_file|push_files|create_pull_request|create_issue|add_issue_comment|update_issue_comment|create_pull_request_review|add_comment_to_pending_review)",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.agents/hooks/secret-scanner.py\""
          }
        ]
      }
    ]
  }
}
